<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_whatsapp_bot" model="ir.module.category">
        <field name="name">WhatsApp Bot</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_whatsapp_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_whatsapp_bot"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_whatsapp_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_whatsapp_bot"/>
        <field name="implied_ids" eval="[(4, ref('group_whatsapp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>

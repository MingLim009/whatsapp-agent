<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_conversation_kanban" model="ir.ui.view">
        <field name="name">whatsapp.conversation.kanban</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" class="o_kanban_mobile" quick_create="false">
                <field name="partner_id"/>
                <field name="stage"/>
                <field name="window_open"/>
                <field name="last_message_preview"/>
                <field name="last_message_date"/>
                <field name="message_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image_fill_left d-none d-md-block">
                                <img t-att-src="kanban_image('res.partner', 'avatar_128', record.partner_id.raw_value)"
                                     class="o_kanban_image_inner_pic" alt="Cliente"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="partner_id"/>
                                </strong>
                                <div class="text-muted small">
                                    <field name="last_message_date" widget="relative"/>
                                    <span t-if="record.window_open.raw_value" class="badge text-bg-success ms-1">24h</span>
                                </div>
                                <div class="o_kanban_record_body text-truncate">
                                    <field name="last_message_preview"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left text-muted small">
                                        <i class="fa fa-comments-o"/> <field name="message_count"/> mensajes
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_whatsapp_conversation_tree" model="ir.ui.view">
        <field name="name">whatsapp.conversation.tree</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <tree string="Conversaciones WhatsApp">
                <field name="partner_id"/>
                <field name="stage"/>
                <field name="window_open"/>
                <field name="last_message_date"/>
                <field name="last_message_preview"/>
                <field name="message_count"/>
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_conversation_form" model="ir.ui.view">
        <field name="name">whatsapp.conversation.form</field>
        <field name="model">whatsapp.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversación WhatsApp">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="stage"/>
                            <field name="window_open"/>
                            <field name="last_inbound_date"/>
                            <field name="last_message_date"/>
                            <field name="message_count"/>
                        </group>
                        <group>
                            <field name="kommo_conversation_id"/>
                            <field name="kommo_client_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mensajes">
                            <field name="message_ids">
                                <tree>
                                    <field name="message_date"/>
                                    <field name="direction"/>
                                    <field name="source"/>
                                    <field name="delivery_state"/>
                                    <field name="body"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_conversation" model="ir.actions.act_window">
        <field name="name">Conversaciones WhatsApp</field>
        <field name="res_model">whatsapp.conversation</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>
</odoo>

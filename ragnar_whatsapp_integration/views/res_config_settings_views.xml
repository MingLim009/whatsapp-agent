<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_whatsapp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.whatsapp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="WhatsApp Bot" name="ragnar_whatsapp_integration">
                    <block title="Kommo / WhatsApp">
                        <setting string="Credenciales Kommo" help="Obtenga scope_id y channel_secret al registrar el canal de chat en Kommo.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="kommo_scope_id" class="col-lg-3"/>
                                    <field name="kommo_scope_id" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="kommo_channel_secret" class="col-lg-3"/>
                                    <field name="kommo_channel_secret" password="True" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="kommo_account_id" class="col-lg-3"/>
                                    <field name="kommo_account_id" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="webhook_base_url" class="col-lg-3"/>
                                    <field name="webhook_base_url" readonly="1" class="col-lg-9"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Plantillas Meta/Kommo">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="kommo_template_opening_id" class="col-lg-3"/>
                                    <field name="kommo_template_opening_id" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="kommo_template_closing_id" class="col-lg-3"/>
                                    <field name="kommo_template_closing_id" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="template_opening_body" class="col-lg-3"/>
                                    <field name="template_opening_body" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="template_closing_body" class="col-lg-3"/>
                                    <field name="template_closing_body" class="col-lg-9"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Claude AI">
                        <setting string="API Anthropic">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="claude_api_key" class="col-lg-3"/>
                                    <field name="claude_api_key" password="True" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="claude_model" class="col-lg-3"/>
                                    <field name="claude_model" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="claude_max_tokens" class="col-lg-3"/>
                                    <field name="claude_max_tokens" class="col-lg-9"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Operaciones Odoo">
                        <setting string="Modelo y estados">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="mock_mode" class="col-lg-3"/>
                                    <field name="mock_mode" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="operation_model" class="col-lg-3"/>
                                    <field name="operation_model" placeholder="ragnar.money.operation" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="operation_created_states" class="col-lg-3"/>
                                    <field name="operation_created_states" class="col-lg-9"/>
                                </div>
                                <div class="row">
                                    <label for="operation_concluded_states" class="col-lg-3"/>
                                    <field name="operation_concluded_states" class="col-lg-9"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
